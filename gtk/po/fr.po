#: facelock_gtk/enroll.py:11 facelock_gtk/enroll.py:147
#: facelock_gtk/tester.py:23
msgid "Look straight at the screen"
msgstr "Regarde l'écran, bien en face"

#: facelock_gtk/enroll.py:12
msgid "Back to the center, facing the screen"
msgstr "Reviens au centre, face à l'écran"

#: facelock_gtk/enroll.py:13
msgid "Slowly turn your head to the left"
msgstr "Tourne doucement la tête vers la gauche"

#: facelock_gtk/enroll.py:14
msgid "A little more to the left"
msgstr "Encore un peu plus à gauche"

#: facelock_gtk/enroll.py:15
msgid "Now turn to the right"
msgstr "Maintenant vers la droite"

#: facelock_gtk/enroll.py:16
msgid "A little more to the right"
msgstr "Encore un peu plus à droite"

#: facelock_gtk/enroll.py:17
msgid "Back to the center, and lift your chin"
msgstr "Reviens au centre et lève un peu le menton"

#: facelock_gtk/enroll.py:18
msgid "Now lower your head a little"
msgstr "Maintenant baisse un peu la tête"

#: facelock_gtk/enroll.py:24
msgid "Face lost — look at the camera"
msgstr "Visage perdu — regarde la caméra"

#: facelock_gtk/enroll.py:25
msgid "A bit more…"
msgstr "Un peu plus…"

#: facelock_gtk/enroll.py:26
msgid "Hold still…"
msgstr "Ne bouge plus…"

#: facelock_gtk/enroll.py:27
msgid "A bit too far, come back slightly"
msgstr "Un peu trop, reviens légèrement"

#: facelock_gtk/enroll.py:28
msgid "Other direction"
msgstr "De l'autre côté"

#: facelock_gtk/enroll.py:29
msgid "Back to the center"
msgstr "Reviens au centre"

#: facelock_gtk/enroll.py:30
msgid "Keep your head level"
msgstr "Garde la tête droite"

#: facelock_gtk/enroll.py:30
msgid "Keep your head centered"
msgstr "Garde la tête au centre"

#: facelock_gtk/enroll.py:42 facelock_gtk/window.py:82
#: facelock_gtk/window.py:165 facelock_gtk/window.py:194
#: facelock_gtk/window.py:326 facelock_gtk/window.py:431
msgid "Add a Face"
msgstr "Ajouter un visage"

#: facelock_gtk/enroll.py:53
msgid "Waiting for authorization…"
msgstr "En attente d'autorisation…"

#: facelock_gtk/enroll.py:54
msgid "Confirm with your password to add a face."
msgstr "Confirme avec ton mot de passe pour ajouter un visage."

#: facelock_gtk/enroll.py:73 facelock_gtk/tester.py:31
#: facelock_gtk/window.py:179 facelock_gtk/window.py:195
msgid "Test Recognition"
msgstr "Tester la reconnaissance"

#: facelock_gtk/enroll.py:75
msgid "Done"
msgstr "Terminé"

#: facelock_gtk/enroll.py:80
msgid "Face Added"
msgstr "Visage ajouté"

#: facelock_gtk/enroll.py:85
msgid "Try Again"
msgstr "Réessayer"

#: facelock_gtk/enroll.py:108 facelock_gtk/settings.py:72
#: facelock_gtk/window.py:331
msgid "Authorization denied"
msgstr "Autorisation refusée"

#: facelock_gtk/enroll.py:108
msgid "Adding a face requires your password."
msgstr "Ajouter un visage nécessite ton mot de passe."

#: facelock_gtk/enroll.py:110
msgid "Camera busy"
msgstr "Caméra occupée"

#: facelock_gtk/enroll.py:110
msgid "Another face operation is in progress."
msgstr "Une autre opération utilise déjà la caméra."

#: facelock_gtk/enroll.py:112
msgid "Could not start"
msgstr "Impossible de démarrer"

#: facelock_gtk/enroll.py:148
msgid "Measuring your reference position"
msgstr "Mesure de ta position de référence"

#: facelock_gtk/enroll.py:156
#, python-brace-format
msgid "Step {n} of {total}"
msgstr "Étape {n} sur {total}"

#: facelock_gtk/enroll.py:190
#, python-brace-format
msgid "You can now unlock with “{label}”."
msgstr "Tu peux maintenant déverrouiller avec « {label} »."

#: facelock_gtk/enroll.py:196
msgid ""
"Not enough head positions were captured. Move slowly and pause at each "
"position."
msgstr ""
"Pas assez de positions capturées. Bouge lentement et marque une pause à "
"chaque position."

#: facelock_gtk/enroll.py:197
msgid "This took too long."
msgstr "Ça a pris trop de temps."

#: facelock_gtk/enroll.py:199
msgid "Face Not Added"
msgstr "Visage non ajouté"

#: facelock_gtk/main.py:66 facelock_gtk/window.py:52 facelock_gtk/window.py:99
#: facelock_gtk/window.py:141
msgid "NovID"
msgstr "NovID"

#: facelock_gtk/main.py:69
msgid "Infrared face authentication with liveness detection"
msgstr "Authentification faciale infrarouge avec détection du vivant"

#: facelock_gtk/settings.py:16
msgid "Settings"
msgstr "Paramètres"

#: facelock_gtk/settings.py:23 facelock_gtk/settings.py:24
msgid "Camera"
msgstr "Caméra"

#: facelock_gtk/settings.py:28
msgid "Allow Regular Webcams"
msgstr "Autoriser les webcams classiques"

#: facelock_gtk/settings.py:29
msgid "Only used when there is no infrared camera"
msgstr "Utilisées uniquement en l'absence de caméra infrarouge"

#: facelock_gtk/settings.py:60 facelock_gtk/window.py:256
msgid "No camera found"
msgstr "Aucune caméra trouvée"

#: facelock_gtk/settings.py:63
msgid "Infrared camera — protected against photos and screens"
msgstr "Caméra infrarouge — protégée contre les photos et les écrans"

#: facelock_gtk/settings.py:65
msgid "Regular webcam — weaker protection; the keyring is never unlocked"
msgstr ""
"Webcam classique — protection plus faible ; le trousseau n'est jamais "
"déverrouillé"

#: facelock_gtk/settings.py:68
msgid "Connect an infrared camera, or allow regular webcams below"
msgstr ""
"Branche une caméra infrarouge, ou autorise les webcams classiques ci-dessous"

#: facelock_gtk/settings.py:83
msgid "Allow Regular Webcams?"
msgstr "Autoriser les webcams classiques ?"

#: facelock_gtk/settings.py:85
msgid ""
"Without an infrared camera, a good photo or video of you may be able to "
"unlock this computer. Your keyring will never be unlocked this way."
msgstr ""
"Sans caméra infrarouge, une bonne photo ou vidéo de toi pourrait "
"déverrouiller cet ordinateur. Ton trousseau ne sera jamais déverrouillé de "
"cette façon."

#: facelock_gtk/settings.py:89 facelock_gtk/window.py:382
#: facelock_gtk/window.py:416 facelock_gtk/window.py:468
msgid "Cancel"
msgstr "Annuler"

#: facelock_gtk/settings.py:90
msgid "Allow"
msgstr "Autoriser"

#: facelock_gtk/tester.py:14
msgid "Recognized"
msgstr "Reconnu"

#: facelock_gtk/tester.py:15
msgid "No face enrolled"
msgstr "Aucun visage enregistré"

#: facelock_gtk/tester.py:16
msgid "No face detected"
msgstr "Aucun visage détecté"

#: facelock_gtk/tester.py:17
msgid "Face not recognized"
msgstr "Visage non reconnu"

#: facelock_gtk/tester.py:18
msgid "The IR emitter is not blinking"
msgstr "L'émetteur infrarouge ne clignote pas"

#: facelock_gtk/tester.py:19
msgid "Too little infrared reflected (screen? too far?)"
msgstr "Trop peu d'infrarouge renvoyé (écran ? trop loin ?)"

#: facelock_gtk/tester.py:20
msgid "Looks like a photo or a screen"
msgstr "Ressemble à une photo ou à un écran"

#: facelock_gtk/tester.py:21
msgid "Photo check models missing for the colour webcam"
msgstr "Modèles anti-photo absents pour la webcam couleur"

#: facelock_gtk/tester.py:22
msgid "Eye reflections don't match the enrolled face"
msgstr "Les reflets des yeux ne correspondent pas au visage enregistré"

#: facelock_gtk/tester.py:24
msgid "Too many failures, try again later"
msgstr "Trop d'échecs, réessaie plus tard"

#: facelock_gtk/tester.py:25
msgid "Camera unavailable"
msgstr "Caméra indisponible"

#: facelock_gtk/tester.py:45
msgid "Eyes"
msgstr "Yeux"

#: facelock_gtk/tester.py:45
msgid "Nose"
msgstr "Nez"

#: facelock_gtk/tester.py:45
msgid "Mouth corners"
msgstr "Coins de la bouche"

#: facelock_gtk/tester.py:48
msgid "Live Measurements"
msgstr "Mesures en direct"

#: facelock_gtk/tester.py:56
msgid "Similarity"
msgstr "Ressemblance"

#: facelock_gtk/tester.py:57
#, python-brace-format
msgid "Needs at least {t:.2f} to unlock"
msgstr "Il faut au moins {t:.2f} pour déverrouiller"

#: facelock_gtk/tester.py:63
msgid "Infrared Reflection"
msgstr "Reflet infrarouge"

#: facelock_gtk/tester.py:63
msgid "Light from the emitter bouncing off your face"
msgstr "Lumière de l'émetteur renvoyée par ton visage"

#: facelock_gtk/tester.py:65
msgid "Live Face"
msgstr "Visage réel"

#: facelock_gtk/tester.py:65
msgid "Chance that this is not a photo or a screen"
msgstr "Probabilité que ce ne soit ni une photo ni un écran"

#: facelock_gtk/tester.py:67
msgid "Head Position"
msgstr "Position de la tête"

#: facelock_gtk/tester.py:67
msgid "Left/right and up/down angle"
msgstr "Angle gauche/droite et haut/bas"

#: facelock_gtk/tester.py:68
msgid "Eye Reflections"
msgstr "Reflets des yeux"

#: facelock_gtk/tester.py:68
msgid "What the emitter's glints suggest"
msgstr "Ce que suggèrent les reflets de l'émetteur"

#: facelock_gtk/tester.py:70
msgid "Test Authentication"
msgstr "Tester l'authentification"

#: facelock_gtk/tester.py:140
msgid "left"
msgstr "gauche"

#: facelock_gtk/tester.py:140
msgid "right"
msgstr "droite"

#: facelock_gtk/tester.py:140
msgid "center"
msgstr "centre"

#: facelock_gtk/tester.py:143
msgid "Glasses"
msgstr "Lunettes"

#: facelock_gtk/tester.py:143
msgid "Bare eyes"
msgstr "Yeux nus"

#: facelock_gtk/tester.py:143
msgid "Undecided"
msgstr "Indéterminé"

#: facelock_gtk/tester.py:149
msgid "Look at the camera…"
msgstr "Regarde la caméra…"

#: facelock_gtk/tester.py:164
msgid "Test failed"
msgstr "Échec du test"

#: facelock_gtk/tester.py:168
msgid "Unlocked"
msgstr "Déverrouillé"

#: facelock_gtk/tester.py:170
msgid "Not unlocked"
msgstr "Non déverrouillé"

#: facelock_gtk/window.py:16
msgid "Terminal (sudo)"
msgstr "Terminal (sudo)"

#: facelock_gtk/window.py:17
msgid "Login and Lock Screen"
msgstr "Connexion et écran de verrouillage"

#: facelock_gtk/window.py:18
msgid "Administrator Prompts"
msgstr "Demandes d'administration"

#: facelock_gtk/window.py:19
msgid "Keyring"
msgstr "Trousseau de clés"

#: facelock_gtk/window.py:72
msgid "Retry"
msgstr "Réessayer"

#: facelock_gtk/window.py:76
msgid "Service Not Available"
msgstr "Service indisponible"

#: facelock_gtk/window.py:77 facelock_gtk/window.py:214
msgid ""
"The facelock service could not be reached. Install the “facelock” package, "
"then try again."
msgstr ""
"Impossible de joindre le service facelock. Installe le paquet « facelock », "
"puis réessaie."

#: facelock_gtk/window.py:86
msgid "Unlock With Your Face"
msgstr "Déverrouille avec ton visage"

#: facelock_gtk/window.py:87
msgid ""
"Use the infrared camera to unlock sudo, the lock screen and system prompts."
msgstr ""
"Utilise la caméra infrarouge pour sudo, l'écran de verrouillage et les "
"demandes d'autorisation du système."

#: facelock_gtk/window.py:152
msgid "Use Your Face For"
msgstr "Utiliser ton visage pour"

#: facelock_gtk/window.py:164
msgid "Add"
msgstr "Ajouter"

#: facelock_gtk/window.py:167
msgid "Your Faces"
msgstr "Tes visages"

#: facelock_gtk/window.py:185
msgid "See what the camera detects and try unlocking"
msgstr "Vois ce que détecte la caméra et essaie de déverrouiller"

#: facelock_gtk/window.py:196
msgid "Camera Settings"
msgstr "Paramètres de la caméra"

#: facelock_gtk/window.py:197
msgid "About NovID"
msgstr "À propos de NovID"

#: facelock_gtk/window.py:250
msgid "Infrared camera ready"
msgstr "Caméra infrarouge prête"

#: facelock_gtk/window.py:253
msgid "Regular webcam — weaker protection"
msgstr "Webcam classique — protection réduite"

#: facelock_gtk/window.py:265 facelock_gtk/window.py:276
msgid "Waiting…"
msgstr "Patiente…"

#: facelock_gtk/window.py:267
msgid "Needs an infrared camera"
msgstr "Nécessite une caméra infrarouge"

#: facelock_gtk/window.py:269
msgid "Turn on Login first"
msgstr "Active d'abord la connexion"

#: facelock_gtk/window.py:271
msgid "Unlocked at login"
msgstr "Déverrouillé à la connexion"

#: facelock_gtk/window.py:271
msgid "Asks for your password"
msgstr "Demande ton mot de passe"

#: facelock_gtk/window.py:276
msgid "On"
msgstr "Activé"

#: facelock_gtk/window.py:276
msgid "Off"
msgstr "Désactivé"

#: facelock_gtk/window.py:291
msgid "If you sometimes wear glasses, add one face with them and one without."
msgstr "Si tu portes parfois des lunettes, ajoute un visage avec et un sans."

#: facelock_gtk/window.py:302
msgid "Add again"
msgstr "À refaire"

#: facelock_gtk/window.py:304
msgid "With glasses"
msgstr "Avec lunettes"

#: facelock_gtk/window.py:306
#, python-brace-format
msgid "{n} positions"
msgstr "{n} positions"

#: facelock_gtk/window.py:315
msgid "Rename…"
msgstr "Renommer…"

#: facelock_gtk/window.py:316
msgid "Remove…"
msgstr "Supprimer…"

#: facelock_gtk/window.py:320
msgid "Made with an older recognition model — add it again"
msgstr "Créé avec un ancien modèle de reconnaissance — ajoute-le à nouveau"

#: facelock_gtk/window.py:367
msgid "Keyring will ask for your password again"
msgstr "Le trousseau demandera de nouveau ton mot de passe"

#: facelock_gtk/window.py:372
msgid "Unlock Keyring With Your Face?"
msgstr "Déverrouiller le trousseau avec ton visage ?"

#: facelock_gtk/window.py:374
msgid ""
"Your login password will be stored on this computer, encrypted by its TPM "
"chip. It cannot be read from another computer or if the disk is removed, but "
"an administrator of this running system could recover it.\n"
"\n"
"If you change your password or update the firmware, turn this option on "
"again."
msgstr ""
"Ton mot de passe de session sera conservé sur cet ordinateur, chiffré par sa "
"puce TPM. Il est illisible depuis un autre ordinateur ou si on retire le "
"disque, mais un administrateur de ce système en marche pourrait le "
"récupérer.\n"
"\n"
"Si tu changes de mot de passe ou mets à jour le firmware, réactive cette "
"option."

#: facelock_gtk/window.py:380
msgid "Login password"
msgstr "Mot de passe de session"

#: facelock_gtk/window.py:383
msgid "Turn On"
msgstr "Activer"

#: facelock_gtk/window.py:403
msgid "Your keyring will unlock when you log in with your face"
msgstr "Ton trousseau se déverrouillera quand tu te connectes avec ton visage"

#: facelock_gtk/window.py:405
msgid "Wrong password"
msgstr "Mot de passe incorrect"

#: facelock_gtk/window.py:429
msgid "Without glasses"
msgstr "Sans lunettes"

#: facelock_gtk/window.py:429 facelock_gtk/window.py:439
msgid "My face"
msgstr "Mon visage"

#: facelock_gtk/window.py:432
msgid ""
"Give it a name, for example “With glasses”. You'll then slowly turn your "
"head while the camera captures several positions."
msgstr ""
"Donne-lui un nom, par exemple « Avec lunettes ». Tu tourneras ensuite "
"lentement la tête pendant que la caméra capture plusieurs positions."

#: facelock_gtk/window.py:434
msgid "Start"
msgstr "Commencer"

#: facelock_gtk/window.py:461
msgid "Rename Face"
msgstr "Renommer le visage"

#: facelock_gtk/window.py:461
msgid "Rename"
msgstr "Renommer"

#: facelock_gtk/window.py:465
#, python-brace-format
msgid "Remove “{label}”?"
msgstr "Supprimer « {label} » ?"

#: facelock_gtk/window.py:466
msgid "You won't be able to unlock with this face anymore."
msgstr "Tu ne pourras plus déverrouiller avec ce visage."

#: facelock_gtk/window.py:469
msgid "Remove"
msgstr "Supprimer"

#: facelock_gtk/window.py:481
#, python-brace-format
msgid "“{label}” removed"
msgstr "« {label} » supprimé"

