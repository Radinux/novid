pkgname = novid
	install = novid.install
	depends = onnxruntime
	depends = dbus
	depends = pam
	depends = polkit
	depends = systemd
	depends = libxcrypt
	depends = gcc-libs
	depends = glibc
	optdepends = novid-gtk: graphical face management
	provides = facelock
	conflicts = facelock
	backup = etc/facelock/config.toml

pkgname = novid-gtk
	pkgdesc = GTK app to manage NovID face profiles
	arch = any
	depends = novid
	depends = python
	depends = python-gobject
	depends = gtk4
	depends = libadwaita
	provides = facelock-gtk
	conflicts = facelock-gtk
