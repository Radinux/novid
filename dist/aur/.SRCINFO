pkgbase = novid
	pkgdesc = Infrared face authentication with liveness detection (sudo, GDM, polkit, keyring)
	pkgver = 0.1.2
	pkgrel = 1
	url = https://github.com/Radinux/novid
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = clang
	makedepends = gettext
	noextract = face_detection_yunet_2026may.onnx
	noextract = face_recognition_sface_2021dec.onnx
	options = !lto
	options = !debug
	source = novid-0.1.2.tar.gz::https://github.com/Radinux/novid/archive/v0.1.2.tar.gz
	source = https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2026may.onnx
	source = https://github.com/opencv/opencv_zoo/raw/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx
	sha256sums = 71b8cbe2c6f98e4669837ea99adc9639608f4b433c325eabdf4ea900ca74c4db
	sha256sums = ebafce4e3c118d6554634be5c27ab333b4c047a9a8c3faf1d7cf93101c22f0f0
	sha256sums = 0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79

pkgname = novid
	install = novid.install
	depends = onnxruntime
	depends = dbus
	depends = pam
	depends = polkit
	depends = systemd
	depends = libxcrypt
	depends = gcc-libs
	depends = glibc
	optdepends = novid-gtk: graphical face management
	provides = facelock
	conflicts = facelock
	backup = etc/facelock/config.toml

pkgname = novid-gtk
	pkgdesc = GTK app to manage NovID face profiles
	arch = any
	depends = novid
	depends = python
	depends = python-gobject
	depends = gtk4
	depends = libadwaita
	provides = facelock-gtk
	conflicts = facelock-gtk
