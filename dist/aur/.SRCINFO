pkgbase = novid
	pkgdesc = Infrared face authentication with liveness detection (sudo, GDM, polkit, keyring)
	pkgver = 0.1.3
	pkgrel = 1
	url = https://github.com/Radinux/novid
	arch = x86_64
	license = GPL-3.0-or-later
	license = MIT
	license = Apache-2.0
	makedepends = cargo
	makedepends = clang
	makedepends = gettext
	noextract = face_detection_yunet_2026may.onnx
	noextract = face_recognition_sface_2021dec.onnx
	noextract = MiniFASNetV2.onnx
	noextract = MiniFASNetV1SE.onnx
	options = !lto
	options = !debug
	source = novid-0.1.3.tar.gz::https://github.com/Radinux/novid/archive/v0.1.3.tar.gz
	source = https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2026may.onnx
	source = https://github.com/opencv/opencv_zoo/raw/main/models/face_recognition_sface/face_recognition_sface_2021dec.onnx
	source = https://github.com/yakhyo/face-anti-spoofing/releases/download/weights/MiniFASNetV2.onnx
	source = https://github.com/yakhyo/face-anti-spoofing/releases/download/weights/MiniFASNetV1SE.onnx
	sha256sums = eab6dff31175f2e1b8cf3a1cdca58b7807d7c8b408e30824dd9f99f75b4baa1f
